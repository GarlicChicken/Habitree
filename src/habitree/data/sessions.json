{
  "version": 1,
  "about": {
    "ko": "세션 기록 분석(audit)이 쓰는 표. 언어·셸·도구에 따라 달라지는 지식은 코드가 아니라 여기에 둔다.",
    "en": "Tables used by session analysis (audit). Knowledge that varies by language, shell or tool lives here, not in code."
  },
  "claude": {
    "ignored_types": ["attachment", "queue-operation", "file-history-snapshot", "file-history-delta", "last-prompt",
                      "ai-title", "mode", "api-request", "api-request-blob", "api-request-shape", "cost-state",
                      "atis-latch", "frame-link", "artifact-comment-monitor", "artifact-autoreact-ledger",
                      "summary", "custom-title", "agent-name", "progress", "tools-used", "pr-link"],
    "system_tags": ["<command-name>", "<command-message>", "<local-command-stdout>", "<local-command-caveat>",
                    "<system-reminder>", "<task-notification>", "<bash-input>", "<bash-stdout>", "Caveat:"]
  },
  "tool_categories": {
    "read": ["Read", "NotebookRead", "LS"],
    "search": ["Grep", "Glob", "ToolSearch"],
    "write": ["Edit", "MultiEdit", "Write", "NotebookEdit"],
    "shell": ["Bash", "PowerShell"],
    "delegate": ["Agent", "Task", "SendMessage"],
    "web": ["WebFetch", "WebSearch"]
  },
  "repeat_ok_tools": ["TaskOutput", "BashOutput", "Monitor", "TaskStop", "TodoWrite", "ScheduleWakeup"],
  "read_only_shell": [
    "ls", "dir", "cat", "type", "head", "tail", "wc", "grep", "rg", "find", "tree", "pwd", "echo", "which",
    "where", "stat", "file", "du", "sort", "uniq", "cut", "jq",
    "git status", "git log", "git diff", "git show", "git blame", "git ls-files", "git grep", "git rev-parse",
    "Get-Content", "Get-ChildItem", "Select-String", "Get-Item", "Test-Path", "Resolve-Path", "Measure-Object"
  ],
  "script_extensions": [".py", ".js", ".mjs", ".cjs", ".ts", ".sh", ".ps1", ".rb", ".pl", ".php", ".go", ".rs"],
  "inline_script": ["<<", "python -c", "python3 -c", "py -c", "node -e", "-Command"],
